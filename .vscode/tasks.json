{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Validate Config",
            "command": "${config:python.pythonPath}",
            "options": {
                "cwd": "${workspaceFolder}/tools"
            },
            "args": [
                "config_style_checker.py"
            ]
        },
        {
            "label": "SQFVM Checker",
            "command": "${config:python.pythonPath}",
            "options": {
                "cwd": "${workspaceFolder}/tools"
            },
            "args": [
                "sqfvmChecker.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "HEMTT check",
            "command": "hemtt",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "check"
            ],
        },
        {
            "label": "Test All",
            "dependsOn": [
                "HEMTT check",
                "Validate Config"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Build: HEMTT",
            "command": "hemtt",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "build",
                "-v"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build: HEMTT --just",
            "command": "python",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "tools/build_current_addon.py",
                "${relativeFile}"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Build: Extension (release)",
            "command": "cargo",
            "options": {
                "cwd": "${workspaceFolder}/extension"
            },
            "args": [
                "build",
                "--release"
            ],
            "group": {
                "kind": "build"
            }
        }
    ]
}
