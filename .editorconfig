# A3SQL — editor configuration
# Top-level: Arma 3 modding conventions (ACE3/CBA)
# extension/: Rust project (4-space indent)

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,hpp,h,sqf,cfg,inc}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{rs,toml,yml,yaml,json,md}]
indent_style = space
indent_size = 4

[*.{py,bat,ps1}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
