#!/bin/sh
# a3sql commit-msg hook — reject AI/tooling identity mentions in messages.
# defence-git-practices: commit messages must contain no AI/tooling mentions.
set -u

msg_file="$1"

if grep -Eiq 'ponytail|sisyphus|opencode|oh-my-opencode|dori' "$msg_file"; then
    echo "✗ commit message contains a banned tooling-identity word" \
        "(ponytail/sisyphus/opencode/oh-my-opencode/dori); remove it and retry." >&2
    exit 1
fi

exit 0
