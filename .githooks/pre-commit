#!/bin/bash
# a3sql pre-commit hook — fast checks only
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

# Banned tooling-identity words must never enter staged content. The hooks
# themselves define this guard, so .githooks/ is exempt — they must spell the
# words to match them. Scans only added lines, not diff headers or context.
BANNED_WORDS='ponytail|sisyphus|opencode|oh-my-opencode|dori'
if git diff --cached -- . ':(exclude).githooks' | grep -E '^\+[^+]' | grep -Eqi "$BANNED_WORDS"; then
    echo "✗ staged content contains a banned tooling-identity word" \
        "(ponytail/sisyphus/opencode/oh-my-opencode/dori)" >&2
    echo "  strip it from the file and re-stage (git add)." >&2
    exit 1
fi

echo "→ cargo fmt --check"
cargo fmt --manifest-path "$ROOT/extension/Cargo.toml" --check || FAILED=1

echo "→ docs static-metric guard (no test counts / versions / MSRV in markdown)"
python3 "$ROOT/tools/check_docs_static.py" >/dev/null 2>&1 || FAILED=1

echo "→ cargo clippy --all-targets"
cargo clippy --manifest-path "$ROOT/extension/Cargo.toml" --all-targets 2>&1 | grep -qE "(warning|error)" && FAILED=1 || true

if command -v hemtt &>/dev/null; then
    echo "→ hemtt check"
    hemtt check 2>/dev/null || FAILED=1
else
    echo "⚠  hemtt not found, skipping"
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "✗ pre-commit hook failed. Fix issues above or use --no-verify to skip."
    exit 1
fi

echo "✓ pre-commit checks passed"
