	class Entities
	{
		items=1;
		class Item0
		{
			dataType="Object";
			class PositionInfo
			{
				position[]={0,1,0};
				angles[]={0,0,0};
			};
			side="Empty";
			flags=4;
			class Attributes
			{
				init="
diag_log '=== A3SQL SMOKE TEST ===';
_v = ""a3sql"" callExtension ""version""; diag_log format [""[A3SQL version] %1"", _v];
_c = ""a3sql"" callExtension ""CREATE TABLE smoke (id STRING PRIMARY KEY, val INT, data STRING)""; diag_log format [""[A3SQL create] %1"", _c];
_i1 = ""a3sql"" callExtension ""INSERT INTO smoke VALUES ('a', 10, 'hello')""; diag_log format [""[A3SQL insert1] %1"", _i1];
_i2 = ""a3sql"" callExtension ""INSERT INTO smoke VALUES ('b', 20, 'world')""; diag_log format [""[A3SQL insert2] %1"", _i2];
_s1 = ""a3sql"" callExtension ""SELECT * FROM smoke""; diag_log format [""[A3SQL select *] %1"", _s1];
_s2 = ""a3sql"" callExtension ""SELECT val FROM smoke WHERE id = 'a'""; diag_log format [""[A3SQL where] %1"", _s2];
_u = ""a3sql"" callExtension ""UPDATE smoke SET val = 15 WHERE id = 'a'""; diag_log format [""[A3SQL update] %1"", _u];
_s3 = ""a3sql"" callExtension ""SELECT val FROM smoke WHERE id = 'a'""; diag_log format [""[A3SQL update verify] %1"", _s3];
_f = ""a3sql"" callExtension ""SELECT id FROM smoke WHERE val %% '10'""; diag_log format [""[A3SQL fuzzy] %1"", _f];
_t = ""a3sql"" callExtension ""BEGIN""; diag_log format [""[A3SQL txn begin] %1"", _t];
_ti = ""a3sql"" callExtension ""INSERT INTO smoke VALUES ('c', 30, 'txn_test')""; diag_log format [""[A3SQL txn insert] %1"", _ti];
_tr = ""a3sql"" callExtension ""ROLLBACK""; diag_log format [""[A3SQL txn rollback] %1"", _tr];
_ts = ""a3sql"" callExtension ""SELECT COUNT(*) FROM smoke WHERE id = 'c'""; diag_log format [""[A3SQL txn verify] %1"", _ts];
_m = ""a3sql"" callExtension ""CREATE TABLE multi_test (k STRING PRIMARY KEY); INSERT INTO multi_test VALUES ('x'); INSERT INTO multi_test VALUES ('y')""; diag_log format [""[A3SQL multi] %1"", _m];
_ag = ""a3sql"" callExtension ""SELECT COUNT(*), SUM(val), AVG(val) FROM smoke""; diag_log format [""[A3SQL agg] %1"", _ag];
_or = ""a3sql"" callExtension ""SELECT id FROM smoke ORDER BY val DESC LIMIT 2""; diag_log format [""[A3SQL order] %1"", _or];
_lk = ""a3sql"" callExtension ""SELECT id FROM smoke WHERE data LIKE 'hel%'""; diag_log format [""[A3SQL like] %1"", _lk];
_ej = ""a3sql"" callExtension ""export json smoke""; diag_log format [""[A3SQL export json] %1"", _ej];
_ec = ""a3sql"" callExtension ""export csv smoke""; diag_log format [""[A3SQL export csv] %1"", _ec];
_nl = ""a3sql"" callExtension ""CREATE TABLE null_test (k STRING PRIMARY KEY, v INT)""; diag_log format [""[A3SQL null table] %1"", _nl];
_n1 = ""a3sql"" callExtension ""INSERT INTO null_test VALUES ('null', NULL)""; diag_log format [""[A3SQL null insert] %1"", _n1];
_ns = ""a3sql"" callExtension ""SELECT * FROM null_test WHERE v IS NULL""; diag_log format [""[A3SQL null select] %1"", _ns];
_ds = ""a3sql"" callExtension ""dump_sql""; diag_log format [""[A3SQL dump sql] %1"", _ds];
diag_log '=== A3SQL STARTING TCP LISTENER ===';
_ls = ""a3sql"" callExtension [""listen"", []]; diag_log format [""[A3SQL listener] %1"", _ls];
diag_log '=== A3SQL SMOKE TEST DONE ===';
";
			};
			id=0;
			type="VirtualCurator_F";
		};
	};
};
