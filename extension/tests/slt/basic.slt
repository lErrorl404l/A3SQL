# Basic A3SQL sqllogictest — core CRUD and type behaviour

statement ok
CREATE TABLE t1 (id INT PRIMARY KEY, name TEXT, value FLOAT)

statement ok
INSERT INTO t1 VALUES (1, 'alpha', 1.5), (2, 'beta', 2.5), (3, 'gamma', 3.5)

query I rowsort
SELECT id FROM t1
----
1
2
3

query T rowsort
SELECT name FROM t1
----
alpha
beta
gamma

query R rowsort
SELECT value FROM t1
----
1.5
2.5
3.5

query II rowsort
SELECT id, id * 2 FROM t1
----
1	2
2	4
3	6

# WHERE filtering
query I rowsort
SELECT id FROM t1 WHERE value > 2.0
----
2
3

# Aggregates
query I
SELECT COUNT(*) FROM t1
----
3

query R
SELECT SUM(value) FROM t1
----
7.5

query I
SELECT MIN(id), MAX(id) FROM t1
----
1	3

# Empty result set
query I
SELECT id FROM t1 WHERE id > 100
----

# ORDER BY
query II
SELECT id, name FROM t1 ORDER BY id DESC
----
3	gamma
2	beta
1	alpha

# UPDATE + DELETE
statement ok
UPDATE t1 SET value = 9.9 WHERE id = 1

statement ok
DELETE FROM t1 WHERE id = 3

query I rowsort
SELECT id FROM t1
----
1
2

# NULL handling
statement ok
INSERT INTO t1 VALUES (4, NULL, NULL)

query T rowsort
SELECT name FROM t1 WHERE name IS NULL
----
NULL

# Boolean predicates
query I rowsort
SELECT id FROM t1 WHERE id IN (1, 2)
----
1
2
