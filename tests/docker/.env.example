# A3SQL docker test rig — environment variables
#
# Copy to .env and adjust for your machine. Everything here is optional;
# the core test needs only CBA (auto-downloaded) and an Arma 3 server.

# Path to your local Arma 3 server install (recommended).
# ARMA3_SERVER_ROOT=/path/to/arma3server

# Let the container install the server via steamcmd (needs credentials
# in tests/docker/config.toml [steam] section).
# ARMA3_SERVER__SKIP_INSTALL=false

# Third-party mods — only needed for the full ballistics mission.
# MOD_ACE_PATH=/path/to/@ace
# MOD_MSS_PATH=/path/to/@mss